APP_ENV=development
MONGO_URL=mongodb://localhost:27017
MONGO_DB=eotoch
# auto: MongoDB олдохгүй бол санах ойн DB | mongo: заавал MongoDB | memory: зөвхөн санах ой
DB_MODE=auto
